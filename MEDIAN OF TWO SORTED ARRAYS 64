n, m = map(int, input().split())
a = list(map(int, input().split()))
b = list(map(int, input().split()))
merged = []
i = j = 0
while i < n and j < m:
    if a[i] <= b[j]:
        merged.append(a[i])
        i += 1
    else:
        merged.append(b[j])
        j += 1
merged.extend(a[i:])
merged.extend(b[j:])
total = n + m
if total % 2:
    print(f"{merged[total // 2]:.1f}")
else:
    median = (merged[total // 2 - 1] + merged[total // 2]) / 2
    print(f"{median:.1f}")
